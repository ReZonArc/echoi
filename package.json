{
  "name": "echoi",
  "version": "0.4.0",
  "description": "🚀 Power Your World with AI - Explore, Extend, Empower.",
  "main": "app/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac:x64": "electron-builder --mac --x64",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:linux": "electron-builder --linux",
    "build:linux:deb": "electron-builder --linux deb",
    "build:all": "electron-builder --win --mac --linux"
  },
  "keywords": [
    "ai",
    "electron",
    "browser",
    "chatgpt",
    "claude",
    "gemini"
  ],
  "author": "ReZonArc",
  "license": "AGPL-3.0",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "extends": null,
    "appId": "com.rezonarc.echoi",
    "productName": "echoi",
    "artifactName": "${productName}_${os}_${version}.${ext}",
    "directories": {
      "output": "dist",
      "app": "."
    },
    "files": [
      "app/**/*",
      "configs/**/*",
      "extensions/**/*",
      "locales/**/*",
      "prompts/**/*",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/*/{CHANGELOG.md,README.md,readme.md,*.map}",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}_macos_${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "artifactName": "${productName}-win32-x64-${version}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "app/icons/icon.ico",
      "uninstallerIcon": "app/icons/icon.ico"
    },
    "dmg": {
      "icon": "app/icons/icon.icns"
    },
    "deb": {
      "artifactName": "${productName}_linux_${arch}_${version}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}_linux_${arch}_${version}.${ext}"
    }
  }
}
